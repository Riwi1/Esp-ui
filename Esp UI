-- DIAGNÓSTICO
--==============================================================
function UI:runDiagnostic()
    self:setStatus("Executando diagnóstico...", "warning")
    
    task.spawn(function()
        task.wait(0.4)
        
        local issues = {}
        
        -- Checa se Drawing API existe (deveria ser restrito)
        if hasDrawing then
            table.insert(issues, "⚠ Drawing API detectada no cliente")
        else
            table.insert(issues, "✓ Drawing API indisponível (bom)")
        end
        
        -- Checa se acesso a Team é replicado
        local teamsReplicated = true
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Team then
                teamsReplicated = true
                break
            end
        end
        if teamsReplicated then
            table.insert(issues, "⚠ Times replicados para o cliente")
        end
        
        -- Checa se posições de inimigos distantes são acessíveis
        local distantAccessible = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist > 500 then
                        distantAccessible = true
                        break
                    end
                end
            end
        end
        if distantAccessible then
            table.insert(issues, "⚠ Inimigos distantes têm posição replicada")
        end
        
        -- Checa Humanoid Health
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then
                    table.insert(issues, "⚠ Health replicado no cliente")
                    break
                end
            end
        end
        
        task.wait(0.6)
        
        -- Mostra resultado
        print("\n══════ DIAGNÓSTICO ESP ══════")
        for _, i in ipairs(issues) do print(i) end
        print("════════════════════════════\n")
        
        self:setStatus("Diagnóstico completo — veja o console (F9)", "success")
    end)
end

