local scanTimer = 0
local objRenderFrame = 0

RunService.RenderStepped:Connect(function(dt)
    scanTimer = scanTimer + dt
    if scanTimer >= CONFIG.ESP.ComputerRescanRate then
        scanTimer = 0
        scanActiveMap()
    end

    local currentRoot = getActiveMapRoot()
    if currentRoot ~= lastMapRoot then
        scanActiveMap()
    end

    local myPos = Camera.CFrame.Position

    -- ============ JOGADORES ============
    if CONFIG.ESP.Enabled then
        for plr, data in pairs(tracked) do
            local char = plr.Character
            if not char or not char.Parent then destroyESP(plr); continue end

            local hrp  = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum  = char:FindFirstChildOfClass("Humanoid")

            local hidden = false
            if not (hrp and head and hum) or hum.Health <= 0 then hidden = true end
            if not hidden then
                local dist = (hrp.Position - myPos).Magnitude
                if dist > CONFIG.ESP.MaxDistance then hidden = true end
            end

            if hidden then
                if data.box then data.box.Visible = false end
                if data.name then data.name.Visible = false end
                if data.role then data.role.Visible = false end
                if data.dist then data.dist.Visible = false end
                if data.hpBg then data.hpBg.Visible = false end
                if data.corners then for _, c in ipairs(data.corners) do c.Visible = false end end
                if data.hl then data.hl.Enabled = false end
                continue
            end

            if data.hl then data.hl.Enabled = CONFIG.ESP.ShowHighlight end

            -- Atualiza role (caso mude)
            if data.role then data.role.Text = getRoleLabel(plr) end

            local headPos, onHead = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local footPos, onFoot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            if not onHead or not onFoot then
                if data.box then data.box.Visible = false end
                if data.name then data.name.Visible = false end
                if data.role then data.role.Visible = false end
                if data.dist then data.dist.Visible = false end
                if data.hpBg then data.hpBg.Visible = false end
                if data.corners then for _, c in ipairs(data.corners) do c.Visible = false end end
                continue
            end

            local topX, topY = headPos.X, headPos.Y
            local botX, botY = footPos.X, footPos.Y
            local boxHeight = math.abs(botY - topY)
            local boxWidth  = boxHeight * 0.55
            local boxX = (topX + botX) / 2 - boxWidth / 2
            local boxY = math.min(topY, botY)

            if CONFIG.ESP.ShowBox and CONFIG.ESP.BoxMode == "Full" then
                data.box.Visible = true
                data.box.Position = UDim2.new(0, boxX, 0, boxY)
                data.box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                data.boxStroke.Enabled = true
                for _, c in ipairs(data.corners) do c.Visible = false end
            elseif CONFIG.ESP.ShowBox and CONFIG.ESP.BoxMode == "Corner" then
                data.box.Visible = false
                data.boxStroke.Enabled = false
                local cLen = math.max(6, math.min(14, boxWidth * 0.25))
                local t = CONFIG.ESP.Thickness
                local positions = {
                    {UDim2.new(0, boxX, 0, boxY),                     UDim2.new(0, cLen, 0, t)},
                    {UDim2.new(0, boxX + boxWidth - cLen, 0, boxY),   UDim2.new(0, cLen, 0, t)},
                    {UDim2.new(0, boxX, 0, boxY + boxHeight - t),     UDim2.new(0, cLen, 0, t)},
                    {UDim2.new(0, boxX + boxWidth - cLen, 0, boxY + boxHeight - t), UDim2.new(0, cLen, 0, t)},
                }
                for i, c in ipairs(data.corners) do
                    c.Visible = true
                    c.Position = positions[i][1]
                    c.Size = positions[i][2]
                end
            else
                data.box.Visible = false
                data.boxStroke.Enabled = false
                for _, c in ipairs(data.corners) do c.Visible = false end
            end

            if CONFIG.ESP.ShowName then
                data.name.Visible = true
                data.name.Position = UDim2.new(0, topX, 0, boxY - 4)
                data.name.Text = plr.Name
                data.role.Visible = true
                data.role.Position = UDim2.new(0, topX, 0, boxY - 16)
            else
                data.name.Visible = false
                data.role.Visible = false
            end

            if CONFIG.ESP.ShowDistance then
                local dist = (hrp.Position - myPos).Magnitude
                data.dist.Visible = true
                data.dist.Position = UDim2.new(0, topX, 0, boxY + boxHeight + 2)
                data.dist.Text = string.format("%dm", math.floor(dist))
            else
                data.dist.Visible = false
            end

            if CONFIG.ESP.ShowHealth then
                data.hpBg.Visible = true
                local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                data.hpBg.Position = UDim2.new(0, boxX - 8, 0, boxY)
                data.hpBg.Size = UDim2.new(0, 3, 0, boxHeight)
                data.hpFg.Size = UDim2.new(1, 0, hpRatio, 0)
                data.hpFg.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
            else
                data.hpBg.Visible = false
            end
        end
    else
        for _, data in pairs(tracked) do
            if data.hl then data.hl.Enabled = false end
            if data.box then data.box.Visible = false end
            if data.name then data.name.Visible = false end
            if data.role then data.role.Visible = false end
            if data.dist then data.dist.Visible = false end
            if data.hpBg then data.hpBg.Visible = false end
            if data.corners then for _, c in ipairs(data.corners) do c.Visible = false end end
        end
    end

    -- ============ OBJETOS a cada 2 frames ============
    objRenderFrame = objRenderFrame + 1
    if objRenderFrame >= 2 then
        objRenderFrame = 0

        -- COMPUTADORES
        if CONFIG.ESP.ShowComputers then
            for inst, data in pairs(trackedObjects) do
                if not inst.Parent then destroyObjESP(inst); continue end

                local pos = inst:IsA("BasePart") and inst.Position or nil
                if not pos then
                    local pp = inst:FindFirstChildWhichIsA("BasePart", true)
                    if pp then pos = pp.Position end
                end
                if not pos and inst:IsA("Model") then
                    pos = inst:GetPivot().Position
                end

                if not pos then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                local dist = (pos - myPos).Magnitude
                if dist > CONFIG.ESP.ComputerMaxDistance then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
                if not onScreen then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                if data.hl then data.hl.Enabled = CONFIG.ESP.ComputerHighlight end

                if CONFIG.ESP.ComputerBox then
                    local size = math.clamp(3000 / math.max(dist, 1), 14, 60)
                    data.box.Visible = true
                    data.box.Position = UDim2.new(0, screenPos.X - size/2, 0, screenPos.Y - size/2)
                    data.box.Size = UDim2.new(0, size, 0, size)
                    data.boxStroke.Enabled = true
                else
                    data.box.Visible = false
                    data.boxStroke.Enabled = false
                end

                if CONFIG.ESP.ComputerName then
                    data.name.Visible = true
                    data.name.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 22)
                    data.name.Text = T("pcShort") .. " " .. inst.Name
                else
                    data.name.Visible = false
                end

                if CONFIG.ESP.ComputerDistance then
                    data.dist.Visible = true
                    data.dist.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y + 18)
                    data.dist.Text = string.format("%dm", math.floor(dist))
                else
                    data.dist.Visible = false
                end
            end
        else
            for _, data in pairs(trackedObjects) do
                if data.hl then data.hl.Enabled = false end
                if data.box then data.box.Visible = false end
                if data.name then data.name.Visible = false end
                if data.dist then data.dist.Visible = false end
            end
        end

        -- JAULAS
        if CONFIG.ESP.ShowCages then
            for inst, data in pairs(trackedCages) do
                if not inst.Parent then destroyCageESP(inst); continue end

                local pos = inst:IsA("BasePart") and inst.Position or nil
                if not pos then
                    local pp = inst:FindFirstChildWhichIsA("BasePart", true)
                    if pp then pos = pp.Position end
                end
                if not pos and inst:IsA("Model") then
                    pos = inst:GetPivot().Position
                end

                if not pos then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                local dist = (pos - myPos).Magnitude
                if dist > CONFIG.ESP.CageMaxDistance then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
                if not onScreen then
                    if data.box then data.box.Visible = false end
                    if data.name then data.name.Visible = false end
                    if data.dist then data.dist.Visible = false end
                    if data.hl then data.hl.Enabled = false end
                    continue
                end

                if data.hl then data.hl.Enabled = CONFIG.ESP.CageHighlight end

                if CONFIG.ESP.CageBox then
                    local size = math.clamp(3500 / math.max(dist, 1), 16, 70)
                    data.box.Visible = true
                    data.box.Position = UDim2.new(0, screenPos.X - size/2, 0, screenPos.Y - size/2)
                    data.box.Size = UDim2.new(0, size, 0, size)
                    data.boxStroke.Enabled = true
                else
                    data.box.Visible = false
                    data.boxStroke.Enabled = false
                end

                if CONFIG.ESP.CageName then
                    data.name.Visible = true
                    data.name.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 24)
                    data.name.Text = T("cageShort") .. " " .. inst.Name
                else
                    data.name.Visible = false
                end

                if CONFIG.ESP.CageDistance then
                    data.dist.Visible = true
                    data.dist.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y + 20)
                    data.dist.Text = string.format("%dm", math.floor(dist))
                else
                    data.dist.Visible = false
                end
            end
        else
            for _, data in pairs(trackedCages) do
                if data.hl then data.hl.Enabled = false end
                if data.box then data.box.Visible = false end
                if data.name then data.name.Visible = false end
                if data.dist then data.dist.Visible = false end
            end
        end
    end
end)

