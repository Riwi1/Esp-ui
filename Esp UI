function UI:runDiagnostic()
    self:setStatus("Diagnóstico...", "warning")
    task.spawn(function()
        task.wait(0.3)
        local issues = {}
        
        if Drawing then
            table.insert(issues, "⚠ Drawing API disponível (overlays externos possíveis)")
        else
            table.insert(issues, "✓ Drawing API indisponível (bom)")
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Team then
                table.insert(issues, "⚠ Times replicados no cliente")
                break
            end
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    table.insert(issues, "⚠ Health replicado no cliente")
                end
                if hrp then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist > 500 then
                        table.insert(issues, "⚠ Inimigos distantes têm posição exposta")
                    end
                end
                break
            end
        end
        
        print("\n═══ DIAGNÓSTICO ESP ═══")
        for _, i in ipairs(issues) do print(i) end
        print("═══════════════════════\n")
        
        self:setStatus("Diagnóstico completo (veja F9)", "success")
    end)
end

