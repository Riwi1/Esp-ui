    for _, btn in ipairs(self.tabButtons) do
        local active = btn.Name == name
        Helpers.tween(btn, 0.2, {
            BackgroundColor3 = active and Theme.colors.bg_tertiary or Theme.colors.bg_secondary,
            TextColor3 = active and Theme.colors.text_primary or Theme.colors.text_secondary,
        })
        Helpers.tween(btn.indicator, 0.2, {
            Size = UDim2.new(0, 3, active and 1 or 0, 0),
        })
    end
    self:renderContent(name)
end

