        Helpers.tween(btn, 0.15, { BackgroundColor3 = color })
    end))
    table.insert(self.connections, btn.MouseButton1Click:Connect(callback))
    
    return btn
end

--==============================================================
-- RENDERIZAÇÃO DAS TABS
--==============================================================
function UI:renderContent(tab)
    self:clearContent()
    local scroll = self:createScrolling()
    
    if tab == "Visual" then
        self:section(scroll, "Elementos")
        self:toggle(scroll, "Caixa (Box)", Config.esp_box, function(v) Config.esp_box = v end)
        self:toggle(scroll, "Nome", Config.esp_name, function(v) Config.esp_name = v end)
        self:toggle(scroll, "Barra de Vida", Config.esp_health, function(v) Config.esp_health = v end)
        self:toggle(scroll, "Distância", Config.esp_distance, function(v) Config.esp_distance = v end)
        self:toggle(scroll, "Tracer (Linha)", Config.esp_tracer, function(v) Config.esp_tracer = v end)
        self:toggle(scroll, "Esqueleto", Config.esp_skeleton, function(v) Config.esp_skeleton = v end)
        self:toggle(scroll, "Box Preenchida", Config.box_filled, function(v) Config.box_filled = v end)
        
        self:section(scroll, "Aparência")
        self:slider(scroll, "Espessura Box", 1, 5, Config.box_thickness, function(v) Config.box_thickness = v end)
        self:slider(scroll, "Tamanho Nome", 10, 22, Config.name_size, function(v) Config.name_size = v end)
        self:slider(scroll, "Espessura Esqueleto", 1, 4, Config.skeleton_thickness, function(v) Config.skeleton_thickness = v end)
        self:slider(scroll, "Transparência da Box", 0, 100, math.floor(Config.box_fill_transparency * 100), function(v) Config.box_fill_transparency = v / 100 end)
        
    elseif tab == "Target" then
        self:section(scroll, "Filtros")
        self:toggle(scroll, "Somente Inimigos (Team Check)", Config.esp_team_check, function(v) Config.esp_team_check = v end)
        self:toggle(scroll, "Somente Visíveis (Raycast)", Config.esp_visible_check, function(v) Config.esp_visible_check = v end)
        
        self:section(scroll, "Alcance")
        self:slider(scroll, "Distância Máxima", 100, 2000, Config.max_distance, function(v) Config.max_distance = v end)
        self:slider(scroll, "Refresh Rate (FPS)", 15, 120, Config.refresh_rate, function(v) Config.refresh_rate = v end)
        
        self:section(scroll, "Tracer")
        self:dropdown(scroll, "Origem do Tracer", {"Bottom", "Center", "Mouse"}, Config.tracer_origin, function(v) Config.tracer_origin = v end)
        
    elseif tab == "Colors" then
        self:section(scroll, "Cores do ESP")
        self:colorPicker(scroll, "Inimigo", Config.color_enemy, function(c) Config.color_enemy = c end)
        self:colorPicker(scroll, "Time", Config.color_team, function(c) Config.color_team = c end)
        self:colorPicker(scroll, "Vida", Config.color_health, function(c) Config.color_health = c end)
        self:colorPicker(scroll, "Nome", Config.color_name, function(c) Config.color_name = c end)
        self:colorPicker(scroll, "Distância", Config.color_distance, function(c) Config.color_distance = c end)
        self:colorPicker(scroll, "Tracer", Config.color_tracer, function(c) Config.color_tracer = c end)
        self:colorPicker(scroll, "Esqueleto", Config.color_skeleton, function(c) Config.color_skeleton = c end)
        
        self:section(scroll, "Presets")
        self:button(scroll, "Resetar Cores Padrão", function()
            Config.color_enemy = Color3.fromRGB(255, 80, 80)
            Config.color_team = Color3.fromRGB(80, 200, 255)
            Config.color_health = Color3.fromRGB(87, 242, 135)
            Config.color_name = Color3.fromRGB(255, 255, 255)
