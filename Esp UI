local function makeSlider(parent, label, yPos, initial, minV, maxV, callback)
    local wrap = create("Frame", {
        Size = UDim2.new(1, -20, 0, 42),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    create("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = PALETTE.TextDim,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = wrap,
    })
    local valLbl = create("TextLabel", {
        Size = UDim2.new(0.4, 0, 0, 16),
        Position = UDim2.new(0.6, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = string.format("%.1f", initial),
        TextColor3 = PALETTE.Text,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = wrap,
    })
    local bar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, 26),
        BackgroundColor3 = PALETTE.LineSoft,
        BorderSizePixel = 0,
        Parent = wrap,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
    local fill = create("Frame", {
        Size = UDim2.new((initial - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = PALETTE.Text,
        BorderSizePixel = 0,
        Parent = bar,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
    local knob = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((initial - minV) / (maxV - minV), 0, 0.5, 0),
        BackgroundColor3 = PALETTE.White,
        BorderSizePixel = 0,
        Parent = bar,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local hit = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = "",
        Parent = wrap,
    })

    local dragging = false
    local function update(rel)
        rel = math.clamp(rel, 0, 1)
        local v = minV + (maxV - minV) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = string.format("%.1f", v)
        if callback then callback(v) end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                     or i.UserInputType == Enum.UserInputType.Touch) then
            update((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return {
        setValue = function(v)
            v = math.clamp(v, minV, maxV)
            update((v - minV) / (maxV - minV))
        end,
    }
end

