local function makeSection(parent, titleKey, yOffset, height)
    local section = create("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        Position = UDim2.new(0, 0, 0, yOffset),
        BackgroundColor3 = PALETTE.Bg1,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        Parent = parent,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = section })
    create("UIStroke", { Color = PALETTE.LineSoft, Thickness = 1, Transparency = 0.5, Parent = section })

    local header = create("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = section })
    local titleLbl = create("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = T(titleKey),
        TextColor3 = PALETTE.TextDim,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })
    registerText(titleLbl, titleKey)

    create("Frame", {
        Size = UDim2.new(1, -28, 0, 1),
        Position = UDim2.new(0, 14, 1, -1),
        BackgroundColor3 = PALETTE.LineSoft,
        BorderSizePixel = 0,
        Parent = header,
    })
    return section
end

--=====================================================================
-- TOGGLE
--=====================================================================
local function makeToggle(parent, labelKey, yPos, initial, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, -20, 0, 28),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    local labelLbl = create("TextLabel", {
        Size = UDim2.new(0.62, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = T(labelKey),
        TextColor3 = initial and PALETTE.Text or PALETTE.TextDim,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    registerText(labelLbl, labelKey)

    local track = create("Frame", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = initial and PALETTE.AccentOn or PALETTE.AccentOff,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Parent = row,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
    local knob = create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = initial and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = initial and PALETTE.Black or PALETTE.TextMute,
        BorderSizePixel = 0,
        Parent = track,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local state = initial
    local function set(v)
        state = v
        tween(track, 0.22, { BackgroundColor3 = v and PALETTE.AccentOn or PALETTE.AccentOff })
        tween(knob, 0.22, {
            Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = v and PALETTE.Black or PALETTE.TextMute,
        }, Enum.EasingStyle.Quint)
        tween(labelLbl, 0.2, { TextColor3 = v and PALETTE.Text or PALETTE.TextDim })
        if callback then callback(v) end
    end
    local hit = create("TextButton", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = "", Parent = row })
    hit.MouseButton1Click:Connect(function() set(not state) end)
    return { set = set, get = function() return state end }
end

--=====================================================================
-- TEXTBOX NUMÉRICA (somente este modo de velocidade é usado)
--=====================================================================
local function makeNumberInput(parent, labelKey, yPos, initial, minV, maxV, onApply)
    local wrap = create("Frame", {
        Size = UDim2.new(1, -20, 0, 52),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    local label = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = T(labelKey),
        TextColor3 = PALETTE.TextDim,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = wrap,
    })
    registerText(label, labelKey)

    local box = create("TextBox", {
        Size = UDim2.new(0.52, -6, 0, 26),
        Position = UDim2.new(0, 0, 0, 20),
        BackgroundColor3 = PALETTE.Bg2,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Text = tostring(initial),
        TextColor3 = PALETTE.Text,
        PlaceholderText = minV .. " - " .. maxV,
        PlaceholderColor3 = PALETTE.TextMute,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        ClearTextOnFocus = false,
        Parent = wrap,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = box })
    local bxStroke = create("UIStroke", { Color = PALETTE.Line, Thickness = 1, Transparency = 0.5, Parent = box })
    box.Focused:Connect(function()
        tween(bxStroke, 0.2, { Color = PALETTE.Text, Transparency = 0.2 })
    end)
    box.FocusLost:Connect(function()
        tween(bxStroke, 0.2, { Color = PALETTE.Line, Transparency = 0.5 })
    end)

    local apply = create("TextButton", {
        Size = UDim2.new(0.48, -6, 0, 26),
        Position = UDim2.new(0.52, 6, 0, 20),
        BackgroundColor3 = PALETTE.Text,
        BorderSizePixel = 0,
        Text = T("apply"),
        TextColor3 = PALETTE.Black,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = wrap,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = apply })
    registerText(apply, "apply")
    apply.MouseEnter:Connect(function()
        tween(apply, 0.15, { BackgroundColor3 = Color3.fromRGB(220, 220, 225) })
    end)
    apply.MouseLeave:Connect(function()
        tween(apply, 0.15, { BackgroundColor3 = PALETTE.Text })
    end)

    local function flash(color)
        local orig = bxStroke.Color
        tween(bxStroke, 0.15, { Color = color, Transparency = 0.1 })
        task.delay(0.7, function()
            tween(bxStroke, 0.3, { Color = orig, Transparency = 0.5 })
        end)
    end

    apply.MouseButton1Click:Connect(function()
        local num = tonumber(box.Text)
        if not num or num ~= num or num < minV or num > maxV then
            flash(Color3.fromRGB(230, 90, 90))
            local prev = box.Text
            box.Text = T("invalid")
            task.delay(0.7, function() box.Text = prev end)
            return
        end
        num = math.floor(num * 10 + 0.5) / 10
        box.Text = tostring(num)
        flash(Color3.fromRGB(120, 220, 160))
        if onApply then onApply(num) end
    end)

    return { setText = function(v) box.Text = tostring(v) end }
end

