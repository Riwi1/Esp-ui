local textRegistry = {}    -- lista de { obj, key }

local function registerText(obj, key)
    table.insert(textRegistry, { obj = obj, key = key })
    obj.Text = T(key)
end

local function refreshTexts()
    for _, entry in ipairs(textRegistry) do
        if entry.obj and entry.obj.Parent then
            entry.obj.Text = T(entry.key)
        end
    end
    TitleLabel.Text = T("title")
    LangBtn.Text = (LANG == "pt") and "PT" or "EN"
    updateStatusPill()
end

