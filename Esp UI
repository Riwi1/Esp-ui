--=====================================================================
-- HELPERS
--=====================================================================
local function create(cls, props)
    local inst = Instance.new(cls)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end

local function tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function containsAny(str, list)
    if not str then return false end
    local lower = str:lower()
    for _, kw in ipairs(list) do
        if lower:find(kw:lower(), 1, true) then
            return true
        end
    end
    return false
end

--=====================================================================
-- DETECÇÃO DA FERA
--=====================================================================
local function isBeast(plr)
    local attr = plr:GetAttribute(CONFIG.ESP.BeastAttribute)
    if attr == true then return true end

    local char = plr.Character
    if char then
        if char:GetAttribute(CONFIG.ESP.BeastAttribute) == true then return true end
        if containsAny(char.Name, CONFIG.ESP.BeastNameMatch) then return true end
        for _, tag in ipairs(CollectionService:GetTags(char)) do
            if containsAny(tag, CONFIG.ESP.BeastNameMatch) then return true end
        end
    end

    for _, tag in ipairs(CollectionService:GetTags(plr)) do
        if containsAny(tag, CONFIG.ESP.BeastNameMatch) then return true end
    end

    if containsAny(plr.Name, CONFIG.ESP.BeastNameMatch) then return true end

    if plr.Team and containsAny(plr.Team.Name, CONFIG.ESP.BeastTeamMatch) then
        return true
    end

    return false
end

local function getESPColor(plr)
    if isBeast(plr) then return ESP_COLORS.Beast end
    return ESP_COLORS.Ally
end

local function getRoleLabel(plr)
    if isBeast(plr) then return "BEAST" end
    return "SURVIVOR"
end

--=====================================================================
-- DETECÇÃO DE COMPUTADORES
--=====================================================================
local function isComputer(inst)
    if not inst or not inst.Parent then return false end
    if inst:IsA("Player") then return false end

    if containsAny(inst.Name, CONFIG.ESP.ComputerNameMatch) then
        return true
    end

    for _, tag in ipairs(CollectionService:GetTags(inst)) do
        if containsAny(tag, CONFIG.ESP.ComputerTagMatch) then
            return true
        end
    end

    return false
end

