function UI:toggle(parent, label, initial, callback)
    local row = Helpers.create("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.colors.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    Helpers.corner(row, 6)
    Helpers.stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    
    Helpers.create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.colors.text_primary,
        TextSize = 13,
        Font = Theme.fonts.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    
    local track = Helpers.create("Frame", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -52, 0.5, -11),
        BackgroundColor3 = initial and Theme.colors.accent or Theme.colors.bg_tertiary,
        BorderSizePixel = 0,
        Parent = row,
    })
    Helpers.corner(track, 11)
    
    local knob = Helpers.create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = initial and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = track,
    })
    Helpers.corner(knob, 9)
    
    local state = initial
    local btn = Helpers.create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    
    local function update(v)
        state = v
        Helpers.tween(track, 0.2, {
            BackgroundColor3 = state and Theme.colors.accent or Theme.colors.bg_tertiary
        })
        Helpers.tween(knob, 0.2, {
            Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        })
        if callback then callback(state) end
    end
    
    local conn = btn.MouseButton1Click:Connect(function()
        update(not state)
    end)
    table.insert(self.connections, conn)
    
    return row, update
end

function UI:slider(parent, label, mn, mx, default, callback)
    local row = Helpers.create("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.colors.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    Helpers.corner(row, 6)
    Helpers.stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    
    local valueLabel = Helpers.create("TextLabel", {
        Size = UDim2.new(0, 80, 0, 20),
        Position = UDim2.new(1, -88, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = Theme.colors.accent,
        TextSize = 13,
        Font = Theme.fonts.title,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })
    
    Helpers.create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.colors.text_primary,
        TextSize = 13,
        Font = Theme.fonts.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    
    local track = Helpers.create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 1, -18),
        BackgroundColor3 = Theme.colors.bg_tertiary,
        BorderSizePixel = 0,
        Parent = row,
    })
    Helpers.corner(track, 3)
    
    local ratio = (default - mn) / (mx - mn)
    local fill = Helpers.create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = Theme.colors.accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    Helpers.corner(fill, 3)
    
    local knob = Helpers.create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = track,
    })
    Helpers.corner(knob, 7)
    Helpers.stroke(knob, Theme.colors.accent, 2, 0)
    
    local value = default
    local dragging = false
    
    local function updateFromX(x)
        local rel = Helpers.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(mn + (mx - mn) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        if callback then callback(value) end
    end
    
    local btn = Helpers.create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    
    table.insert(self.connections, btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(input.Position.X)
        end
    end))
    
    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end))
    
    table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))
    
    return row, function(v)
        value = v
        local rel = (v - mn) / (mx - mn)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
    end
end

