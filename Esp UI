-- Toggle COM checkbox visual + hotkey
function UI:toggle(parent, label, key, initial, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(row, 6)
    stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    
    -- Indicador de status (checkbox visual)
    local checkbox = create("Frame", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 12, 0.5, -10),
        BackgroundColor3 = initial and Theme.accent or Theme.bg_tertiary,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(checkbox, 5)
    stroke(checkbox, initial and Theme.accent or Color3.fromRGB(60, 60, 75), 2, 0)
    
    local check = create("TextLabel", {
        Name = "CheckMark",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = initial and "✓" or "",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        Font = FONTS.title,
        Parent = checkbox,
    })
    
    -- Label
    create("TextLabel", {
        Size = UDim2.new(1, -150, 1, 0),
        Position = UDim2.new(0, 42, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    
    -- Hotkey badge
    local keyName = key and key.Name or ""
    local keyBadge = create("TextLabel", {
        Size = UDim2.new(0, 50, 0, 20),
        Position = UDim2.new(1, -120, 0.5, -10),
        BackgroundColor3 = Theme.bg_tertiary,
        BorderSizePixel = 0,
        Text = keyName,
        TextColor3 = Theme.text_muted,
        TextSize = 10,
        Font = FONTS.heading,
        Parent = row,
    })
    corner(keyBadge, 4)
    
    -- Track do switch
    local track = create("Frame", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -58, 0.5, -11),
        BackgroundColor3 = initial and Theme.success or Theme.bg_tertiary,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(track, 11)
    
    local knob = create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = initial and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, 9)
    
    local state = initial
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    
    local function setState(v)
        state = v
        tween(track, 0.2, { BackgroundColor3 = state and Theme.success or Theme.bg_tertiary })
        tween(knob, 0.2, { Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) })
        tween(checkbox, 0.2, { BackgroundColor3 = state and Theme.accent or Theme.bg_tertiary })
        local chkStroke = checkbox:FindFirstChildOfClass("UIStroke")
        if chkStroke then chkStroke.Color = state and Theme.accent or Color3.fromRGB(60, 60, 75) end
        check.Text = state and "✓" or ""
        if callback then callback(state) end
    end
    
    table.insert(self.connections, btn.MouseButton1Click:Connect(function()
        setState(not state)
    end))
    
    -- Retorna o updater para o hotkey conseguir sincronizar
    return row, setState
end

function UI:slider(parent, label, mn, mx, default, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(row, 6)
    stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    
    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0, 80, 0, 20),
        Position = UDim2.new(1, -88, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = Theme.accent,
        TextSize = 13,
        Font = FONTS.title,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    
    local track = create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 1, -18),
        BackgroundColor3 = Theme.bg_tertiary,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(track, 3)
    
    local ratio = (default - mn) / (mx - mn)
    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 3)
    
    local knob = create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, 7)
    stroke(knob, Theme.accent, 2, 0)
    
    local dragging = false
    local function updateFromX(x)
        local rel = clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = math.floor(mn + (mx - mn) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        if callback then callback(v) end
    end
    
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    table.insert(self.connections, btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(input.Position.X)
        end
    end))
    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end))
    table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
    return row
end

function UI:button(parent, label, callback, style)
    local color = style == "danger" and Theme.danger
        or style == "primary" and Theme.accent
        or Theme.bg_tertiary
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Text = label,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.heading,
        AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, 6)
    stroke(btn, Color3.new(1, 1, 1), 1, 0.85)
    table.insert(self.connections, btn.MouseEnter:Connect(function()
        tween(btn, 0.15, { BackgroundColor3 = lerpColor(color, Color3.new(1,1,1), 0.15) })
    end))
    table.insert(self.connections, btn.MouseLeave:Connect(function()
        tween(btn, 0.15, { BackgroundColor3 = color })
    end))
    table.insert(self.connections, btn.MouseButton1Click:Connect(callback))
    return btn
end

function UI:colorPicker(parent, label, initial, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(row, 6)
    stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local swatch = create("Frame", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -52, 0.5, -11),
        BackgroundColor3 = initial,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(swatch, 6)
    stroke(swatch, Color3.new(1,1,1), 1, 0.6)
    local presets = {
        Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 165, 0),
        Color3.fromRGB(254, 231, 92), Color3.fromRGB(87, 242, 135),
        Color3.fromRGB(80, 200, 255), Color3.fromRGB(88, 101, 242),
        Color3.fromRGB(200, 100, 255), Color3.fromRGB(255, 255, 255),
    }
    local idx = 1
    for i, p in ipairs(presets) do if p == initial then idx = i break end end
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row,
    })
    table.insert(self.connections, btn.MouseButton1Click:Connect(function()
        idx = idx % #presets + 1
        local c = presets[idx]
        swatch.BackgroundColor3 = c
        if callback then callback(c) end
    end))
    return row
end

function UI:keybindRow(parent, label, key, onCapture)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(row, 6)
    stroke(row, Color3.fromRGB(45, 45, 58), 1, 0.5)
    create("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.body,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    local keyLabel = create("TextButton", {
        Size = UDim2.new(0, 90, 0, 24),
        Position = UDim2.new(1, -102, 0.5, -12),
        BackgroundColor3 = Theme.bg_tertiary,
        BorderSizePixel = 0,
        Text = key.Name,
        TextColor3 = Theme.accent,
        TextSize = 12,
        Font = FONTS.heading,
        AutoButtonColor = false,
        Parent = row,
    })
    corner(keyLabel, 4)
    stroke(keyLabel, Theme.accent, 1, 0.5)
    
    local waiting = false
    local conn
    table.insert(self.connections, keyLabel.MouseButton1Click:Connect(function()
        if waiting then return end
        waiting = true
        keyLabel.Text = "[...]"
        keyLabel.TextColor3 = Theme.warning
        local connInput
        connInput = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                keyLabel.Text = input.KeyCode.Name
                keyLabel.TextColor3 = Theme.accent
                waiting = false
                if onCapture then onCapture(input.KeyCode) end
                connInput:Disconnect()
            end
        end)
        table.insert(self.connections, connInput)
    end))
    return row
end

