--=====================================================================
-- LOOP DE ATUALIZAÇÃO DO ESP (RenderStepped)
--=====================================================================
RunService.RenderStepped:Connect(function()
    if not CONFIG.ESP.Enabled then
        -- esconde tudo
        for _, data in pairs(tracked) do
            if data.box then data.box.Visible = false end
            if data.name then data.name.Visible = false end
            if data.role then data.role.Visible = false end
            if data.dist then data.dist.Visible = false end
            if data.hpBg then data.hpBg.Visible = false end
            if data.corners then
                for _, c in ipairs(data.corners) do c.Visible = false end
            end
        end
        return
    end

    local myPos = Camera.CFrame.Position

    for plr, data in pairs(tracked) do
        local char = plr.Character
        if not char or not char.Parent then
            destroyESP(plr)
            continue
        end

        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")

        if not (hrp and head and hum) or hum.Health <= 0 then
            if data.box then data.box.Visible = false end
            if data.name then data.name.Visible = false end
            if data.role then data.role.Visible = false end
            if data.dist then data.dist.Visible = false end
            if data.hpBg then data.hpBg.Visible = false end
            if data.corners then
                for _, c in ipairs(data.corners) do c.Visible = false end
            end
            continue
        end

        -- Distância
        local dist = (hrp.Position - myPos).Magnitude
        if dist > CONFIG.ESP.MaxDistance then
            if data.box then data.box.Visible = false end
            if data.name then data.name.Visible = false end
            if data.role then data.role.Visible = false end
            if data.dist then data.dist.Visible = false end
            if data.hpBg then data.hpBg.Visible = false end
            if data.corners then
                for _, c in ipairs(data.corners) do c.Visible = false end
            end
            continue
        end

        -- Projeção dos pontos
        local headPos, onHead = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local footPos, onFoot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

        if not onHead or not onFoot then
            if data.box then data.box.Visible = false end
            if data.name then data.name.Visible = false end
            if data.role then data.role.Visible = false end
            if data.dist then data.dist.Visible = false end
            if data.hpBg then data.hpBg.Visible = false end
            if data.corners then
                for _, c in ipairs(data.corners) do c.Visible = false end
            end
            continue
        end

        local topX, topY = headPos.X, headPos.Y
        local botX, botY = footPos.X, footPos.Y

        local boxHeight = math.abs(botY - topY)
        local boxWidth  = boxHeight * 0.55

        local boxX = (topX + botX) / 2 - boxWidth / 2
        local boxY = math.min(topY, botY)

        -- BOX FULL
        if CONFIG.ESP.ShowBox and CONFIG.ESP.BoxMode == "Full" then
            data.box.Visible = true
            data.box.Position = UDim2.new(0, boxX, 0, boxY)
            data.box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
            data.boxStroke.Enabled = true
            for _, c in ipairs(data.corners) do c.Visible = false end
        -- BOX CORNERS
        elseif CONFIG.ESP.ShowBox and CONFIG.ESP.BoxMode == "Corner" then
            data.box.Visible = false
            data.boxStroke.Enabled = false
            local cLen = math.max(6, math.min(14, boxWidth * 0.25))
            local t = CONFIG.ESP.Thickness

            -- [1] TL  [2] TR  [3] BL  [4] BR
            local positions = {
                {UDim2.new(0, boxX, 0, boxY),                     UDim2.new(0, cLen, 0, t)},              -- TL horizontal
                {UDim2.new(0, boxX + boxWidth - cLen, 0, boxY),   UDim2.new(0, cLen, 0, t)},              -- TR horizontal
                {UDim2.new(0, boxX, 0, boxY + boxHeight - t),     UDim2.new(0, cLen, 0, t)},              -- BL horizontal
                {UDim2.new(0, boxX + boxWidth - cLen, 0, boxY + boxHeight - t), UDim2.new(0, cLen, 0, t)},  -- BR horizontal
            }
            for i, c in ipairs(data.corners) do
                c.Visible = true
                c.Position = positions[i][1]
                c.Size = positions[i][2]
            end
        else
            data.box.Visible = false
            data.boxStroke.Enabled = false
            for _, c in ipairs(data.corners) do c.Visible = false end
        end

        -- NAME
        if CONFIG.ESP.ShowName then
            data.name.Visible = true
            data.name.Position = UDim2.new(0, topX, 0, boxY - 4)
            data.name.Text = plr.Name
        else
            data.name.Visible = false
        end

        -- ROLE LABEL
        if CONFIG.ESP.ShowName then
            data.role.Visible = true
            data.role.Position = UDim2.new(0, topX, 0, boxY - 16)
            data.role.Text = getRoleLabel(plr)
        else
            data.role.Visible = false
        end

        -- DISTANCE
        if CONFIG.ESP.ShowDistance then
            data.dist.Visible = true
            data.dist.Position = UDim2.new(0, topX, 0, boxY + boxHeight + 2)
            data.dist.Text = string.format("%dm", math.floor(dist))
        else
            data.dist.Visible = false
        end

        -- HEALTH BAR
        if CONFIG.ESP.ShowHealth then
            data.hpBg.Visible = true
            local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            data.hpBg.Position = UDim2.new(0, boxX - 8, 0, boxY)
            data.hpBg.Size = UDim2.new(0, 3, 0, boxHeight)
            data.hpFg.Size = UDim2.new(1, 0, hpRatio, 0)
            data.hpFg.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
        else
            data.hpBg.Visible = false
        end
    end
end)

