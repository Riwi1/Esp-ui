--=====================================================================
local function getESPColor(plr)
    -- Time inimigo (Fera) → destaque branco
    -- Aliados → cinza
    local teamName = plr.Team and plr.Team.Name or "Survivors"
    local myTeamName = LocalPlayer.Team and LocalPlayer.Team.Name or "Survivors"
    if teamName == myTeamName then
        return CONFIG.ESP.ColorAlly
    end
    return CONFIG.ESP.ColorEnemy
end

local function getRoleLabel(plr)
    -- Etiqueta simples baseada no nome do time
    if plr.Team then
        return plr.Team.Name:upper()
    end
    return "?"
end

local function destroyESP(plr)
    local data = tracked[plr]
    if not data then return end
    for _, obj in pairs(data) do
        if typeof(obj) == "Instance" and obj.Parent then
            obj:Destroy()
        end
    end
    tracked[plr] = nil
end

local function buildESP(plr)
    destroyESP(plr)

    -- Highlight
    local char = plr.Character
    if not char then return end

    local color = getESPColor(plr)

    local hl = Instance.new("Highlight")
    hl.Name = "MonoESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 1
    hl.OutlineTransparency = CONFIG.ESP.Transparency
    hl.FillColor = color
    hl.OutlineColor = color
    hl.Adornee = char
    hl.Parent = char

    -- Caixa
    local box = create("Frame", {
        Name = "MonoESP_Box",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        Parent = ESPOverlay,
    })

    local boxStroke = create("UIStroke", {
        Color = color,
        Thickness = CONFIG.ESP.Thickness,
        Transparency = CONFIG.ESP.Transparency,
        Parent = box,
    })

    -- Cantos da caixa (4 mini strokes)
    local corners = {}
    for i = 1, 4 do
        local c = create("Frame", {
            BackgroundColor3 = color,
            BackgroundTransparency = CONFIG.ESP.Transparency,
            BorderSizePixel = 0,
            Visible = false,
            Parent = ESPOverlay,
        })
        corners[i] = c
    end

    -- Nome
    local nameLbl = create("TextLabel", {
        Name = "MonoESP_Name",
        BackgroundTransparency = 1,
        Text = plr.Name,
        TextColor3 = color,
        TextTransparency = CONFIG.ESP.Transparency,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 160, 0, 14),
        AnchorPoint = Vector2.new(0.5, 1),
        Visible = false,
        Parent = ESPOverlay,
    })

    -- Papel (BEAST / SURVIVOR)
    local roleLbl = create("TextLabel", {
        Name = "MonoESP_Role",
        BackgroundTransparency = 1,
        Text = getRoleLabel(plr),
        TextColor3 = color,
        TextTransparency = math.min(1, CONFIG.ESP.Transparency + 0.15),
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextStrokeTransparency = 0.5,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 160, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0),
        Visible = false,
        Parent = ESPOverlay,
    })

    -- Distância
    local distLbl = create("TextLabel", {
        Name = "MonoESP_Dist",
        BackgroundTransparency = 1,
        Text = "0m",
        TextColor3 = color,
        TextTransparency = CONFIG.ESP.Transparency,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 100, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0),
        Visible = false,
        Parent = ESPOverlay,
    })

    -- Barra de vida (fundo + frente)
    local hpBg = create("Frame", {
        Name = "MonoESP_HpBg",
        BackgroundColor3 = Color3.fromRGB(20, 20, 22),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Visible = false,
        Parent = ESPOverlay,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpBg })

    local hpFg = create("Frame", {
        Name = "MonoESP_HpFg",
        BackgroundColor3 = color,
        BackgroundTransparency = CONFIG.ESP.Transparency,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Parent = hpBg,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpFg })

    tracked[plr] = {
        hl = hl,
        box = box,
        boxStroke = boxStroke,
        corners = corners,
        name = nameLbl,
        role = roleLbl,
        dist = distLbl,
        hpBg = hpBg,
        hpFg = hpFg,
    }
end

--=====================================================================
-- UPDATE VISUAL DO ESP
--=====================================================================
function updateESPStyles()
    for plr, data in pairs(tracked) do
        local color = getESPColor(plr)
        if data.hl then
            data.hl.FillColor = color
            data.hl.OutlineColor = color
            data.hl.OutlineTransparency = CONFIG.ESP.Transparency
            data.hl.Enabled = CONFIG.ESP.Enabled and CONFIG.ESP.ShowHighlight
        end
        if data.boxStroke then
            data.boxStroke.Color = color
            data.boxStroke.Thickness = CONFIG.ESP.Thickness
            data.boxStroke.Transparency = CONFIG.ESP.Transparency
        end
        if data.name then
            data.name.TextColor3 = color
            data.name.TextTransparency = CONFIG.ESP.Transparency
        end
        if data.role then
            data.role.TextColor3 = color
            data.role.TextTransparency = math.min(1, CONFIG.ESP.Transparency + 0.15)
        end
        if data.dist then
            data.dist.TextColor3 = color
            data.dist.TextTransparency = CONFIG.ESP.Transparency
        end
        if data.hpFg then
            data.hpFg.BackgroundColor3 = color
            data.hpFg.BackgroundTransparency = CONFIG.ESP.Transparency
        end
        if data.corners then
            for _, c in ipairs(data.corners) do
                c.BackgroundColor3 = color
                c.BackgroundTransparency = CONFIG.ESP.Transparency
            end
        end
    end
end

