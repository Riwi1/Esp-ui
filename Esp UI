function updateESPStyles()
    for plr, data in pairs(tracked) do
        local color = getESPColor(plr)
        if data.hl then
            data.hl.FillColor = color; data.hl.OutlineColor = color
            data.hl.OutlineTransparency = CONFIG.ESP.Transparency
            data.hl.Enabled = CONFIG.ESP.Enabled and CONFIG.ESP.ShowHighlight
        end
        if data.boxStroke then
            data.boxStroke.Color = color
            data.boxStroke.Thickness = CONFIG.ESP.Thickness
            data.boxStroke.Transparency = CONFIG.ESP.Transparency
        end
        if data.name then data.name.TextColor3 = color; data.name.TextTransparency = CONFIG.ESP.Transparency end
        if data.role then data.role.TextColor3 = color; data.role.TextTransparency = math.min(1, CONFIG.ESP.Transparency + 0.15) end
        if data.dist then data.dist.TextColor3 = color; data.dist.TextTransparency = CONFIG.ESP.Transparency end
        if data.hpFg then data.hpFg.BackgroundColor3 = color; data.hpFg.BackgroundTransparency = CONFIG.ESP.Transparency end
        if data.corners then
            for _, c in ipairs(data.corners) do
                c.BackgroundColor3 = color
                c.BackgroundTransparency = CONFIG.ESP.Transparency
            end
        end
    end
    for _, data in pairs(trackedObjects) do
        if data.boxStroke then
            data.boxStroke.Color = ESP_COLORS.Computer
            data.boxStroke.Thickness = CONFIG.ESP.Thickness
            data.boxStroke.Transparency = CONFIG.ESP.Transparency
        end
        if data.hl then
            data.hl.FillColor = ESP_COLORS.Computer
            data.hl.OutlineColor = ESP_COLORS.Computer
            data.hl.OutlineTransparency = CONFIG.ESP.Transparency
        end
        if data.name then data.name.TextColor3 = ESP_COLORS.Computer; data.name.TextTransparency = CONFIG.ESP.Transparency end
        if data.dist then data.dist.TextColor3 = ESP_COLORS.Computer; data.dist.TextTransparency = CONFIG.ESP.Transparency end
    end
    for _, data in pairs(trackedCages) do
        if data.boxStroke then
            data.boxStroke.Color = ESP_COLORS.Cage
            data.boxStroke.Thickness = CONFIG.ESP.Thickness
            data.boxStroke.Transparency = CONFIG.ESP.Transparency
        end
        if data.hl then
            data.hl.FillColor = ESP_COLORS.Cage
            data.hl.OutlineColor = ESP_COLORS.Cage
            data.hl.OutlineTransparency = CONFIG.ESP.Transparency
        end
        if data.name then data.name.TextColor3 = ESP_COLORS.Cage; data.name.TextTransparency = CONFIG.ESP.Transparency end
        if data.dist then data.dist.TextColor3 = ESP_COLORS.Cage; data.dist.TextTransparency = CONFIG.ESP.Transparency end
    end
end

--=====================================================================
-- SCAN DO MAPA ATIVO
--=====================================================================
local function scanActiveMap()
    local mapRoot = getActiveMapRoot()
    activeMapRoot = mapRoot

    local mapChanged = (mapRoot ~= lastMapRoot)
    if not mapChanged then return end

    lastMapRoot = mapRoot
    currentMapScanCount = 0
    currentCageScanCount = 0

    for inst in pairs(trackedObjects) do destroyObjESP(inst) end
    for inst in pairs(trackedCages) do destroyCageESP(inst) end

    local scanRoot = mapRoot or Workspace
    for _, inst in ipairs(scanRoot:GetDescendants()) do
        if isInExcludedContainer(inst) then continue end

        if CONFIG.ESP.ShowComputers and currentMapScanCount < CONFIG.ESP.ComputerMaxCount then
            if isComputer(inst) and not trackedObjects[inst] then
                buildObjESP(inst)
                currentMapScanCount = currentMapScanCount + 1
            end
        end
        if CONFIG.ESP.ShowCages and currentCageScanCount < CONFIG.ESP.CageMaxCount then
            if not trackedObjects[inst] and isCage(inst) and not trackedCages[inst] then
                buildCageESP(inst)
                currentCageScanCount = currentCageScanCount + 1
            end
        end
    end
end

