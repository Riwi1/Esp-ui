local function makeCtrlButton(text, xOff, hoverBg)
    local btn = create("TextButton", {
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(1, xOff, 0.5, -14),
        BackgroundColor3 = PALETTE.Bg2,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = PALETTE.TextDim,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = TopBar,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = btn })
    local s = create("UIStroke", { Color = PALETTE.Line, Thickness = 1, Transparency = 0.5, Parent = btn })
    btn.MouseEnter:Connect(function()
        tween(btn, 0.18, { BackgroundColor3 = hoverBg, BackgroundTransparency = 0 })
        tween(btn, 0.18, { TextColor3 = PALETTE.White })
        tween(s, 0.18, { Transparency = 0.2 })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.18, { BackgroundColor3 = PALETTE.Bg2, BackgroundTransparency = 0.35 })
        tween(btn, 0.18, { TextColor3 = PALETTE.TextDim })
        tween(s, 0.18, { Transparency = 0.5 })
    end)
    return btn
end

