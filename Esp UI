function UI:createTabButton(parent, name, icon)
    local btn = create("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Text = "  " .. icon .. "   " .. name,
        TextColor3 = Theme.text_secondary,
        TextSize = 13,
        Font = FONTS.heading,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, 6)
    
    local ind = create("Frame", {
        Name = "Indicator",
        Size = UDim2.new(0, 3, 0, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
        Parent = btn,
    })
    corner(ind, 2)
    
    table.insert(self.connections, btn.MouseEnter:Connect(function()
        if self.activeTab ~= name then
            tween(btn, 0.15, { BackgroundColor3 = Theme.bg_tertiary })
        end
    end))
    table.insert(self.connections, btn.MouseLeave:Connect(function()
        if self.activeTab ~= name then
            tween(btn, 0.15, { BackgroundColor3 = Theme.bg_secondary })
        end
    end))
    table.insert(self.connections, btn.MouseButton1Click:Connect(function()
        self:selectTab(name)
    end))
    
    btn.indicator = ind
    table.insert(self.tabButtons, btn)
end

function UI:selectTab(name)
    self.activeTab = name
    for _, btn in ipairs(self.tabButtons) do
        local active = btn.Name == name
        tween(btn, 0.2, {
            BackgroundColor3 = active and Theme.bg_tertiary or Theme.bg_secondary,
            TextColor3 = active and Theme.text_primary or Theme.text_secondary,
        })
        tween(btn.indicator, 0.2, {
            Size = UDim2.new(0, 3, active and 1 or 0, 0),
        })
    end
    self:renderContent(name)
end

