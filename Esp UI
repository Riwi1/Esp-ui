local ESPRenderer = {}
ESPRenderer.__index = ESPRenderer

function ESPRenderer.new()
    local self = setmetatable({}, ESPRenderer)
    self.cache = {} -- [player] = { elements... }
    self.connections = {}
    return self
end

function ESPRenderer:getElements(player)
    if self.cache[player] then return self.cache[player] end
    
    local el = {
        box_outline = Draw.new("Square", { Thickness = 1, Filled = false, Visible = false }),
        box_fill    = Draw.new("Square", { Thickness = 1, Filled = true,  Visible = false }),
        tracer      = Draw.new("Line",   { Thickness = 1, Visible = false }),
        name        = Draw.new("Text",   { Size = 13, Center = true, Outline = true, Visible = false }),
        distance    = Draw.new("Text",   { Size = 12, Center = true, Outline = true, Visible = false }),
        health_bar_bg = Draw.new("Square", { Filled = true, Thickness = 0, Visible = false }),
        health_bar_fg = Draw.new("Square", { Filled = true, Thickness = 0, Visible = false }),
        health_text   = Draw.new("Text", { Size = 11, Center = true, Outline = true, Visible = false }),
        arrow       = Draw.new("Triangle", { Thickness = 1, Filled = true, Visible = false }),
        -- Esqueleto
        sk_head_top = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_neck     = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_hip      = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_l_arm    = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_r_arm    = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_l_leg    = Draw.new("Line", { Thickness = 1, Visible = false }),
        sk_r_leg    = Draw.new("Line", { Thickness = 1, Visible = false }),
    }
    self.cache[player] = el
    return el
end

function ESPRenderer:hideAll(el)
    for _, v in pairs(el) do
        if v then v.Visible = false end
    end
end

function ESPRenderer:destroy(player)
    local el = self.cache[player]
    if not el then return end
    for _, v in pairs(el) do
        if v and v.Remove then pcall(function() v:Remove() end) end
    end
    self.cache[player] = nil
end

function ESPRenderer:destroyAll()
    for player in pairs(self.cache) do
        self:destroy(player)
    end
end

-- Verifica se é inimigo
function ESPRenderer:isEnemy(player)
    if not Config.esp_team_check then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

-- Obtém dados 2D do personagem
function ESPRenderer:getData(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not (hrp and head and humanoid) then return nil end
    if humanoid.Health <= 0 then return nil end
    
    -- Usa o tamanho do HumanoidRootPart para escalar corretamente
    local rootSize = hrp.Size
    local topWorld = head.Position + Vector3.new(0, 0.6, 0)
    local bottomWorld = hrp.Position - Vector3.new(0, rootSize.Y * 0.5 + 1.5, 0)
    
    -- Também mede largura usando os ombros
    local lArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm")
    local rArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
    
    local topScreen, topOn = Camera:WorldToViewportPoint(topWorld)
    local bottomScreen, bottomOn = Camera:WorldToViewportPoint(bottomWorld)
    
    if not (topOn and bottomOn) then return nil end
    
    local height = math.abs(bottomScreen.Y - topScreen.Y)
    local width = height * 0.55
    local x = topScreen.X - width / 2
    local y = topScreen.Y
    
    return {
        x = x, y = y,
        width = width, height = height,
        cx = x + width / 2,
        cy = y + height / 2,
        topY = y,
        bottomY = y + height,
        headPos = head.Position,
        rootPos = hrp.Position,
        distance = (Camera.CFrame.Position - hrp.Position).Magnitude,
        humanoid = humanoid,
        name = character.Name,
        character = character,
    }
end

-- Desenha esqueleto
function ESPRenderer:drawSkeleton(el, character, color)
    local function w2v(pos)
        local s, on = Camera:WorldToViewportPoint(pos)
        if not on then return nil end
        return Vector2.new(s.X, s.Y)
    end
    
    local parts = {
        head = character:FindFirstChild("Head"),
        hrp  = character:FindFirstChild("HumanoidRootPart"),
        larm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"),
        rarm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"),
        lleg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg"),
        rleg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg"),
    }
    
    if not (parts.head and parts.hrp) then
        for _, k in ipairs({"sk_head_top","sk_neck","sk_hip","sk_l_arm","sk_r_arm","sk_l_leg","sk_r_leg"}) do
            if el[k] then el[k].Visible = false end
        end
        return
    end
    
    local headPos = w2v(parts.head.Position)
    local hrpPos  = w2v(parts.hrp.Position)
    
    -- Pescoço (head -> hrp)
    if el.sk_neck and headPos and hrpPos then
        el.sk_neck.From = headPos
        el.sk_neck.To = hrpPos
        el.sk_neck.Color = color
        el.sk_neck.Thickness = Config.skeleton_thickness
        el.sk_neck.Visible = true
    end
    
    -- Braços
    if parts.larm and hrpPos then
        local p = w2v(parts.larm.Position)
        if p and el.sk_l_arm then
            el.sk_l_arm.From = hrpPos; el.sk_l_arm.To = p
            el.sk_l_arm.Color = color; el.sk_l_arm.Thickness = Config.skeleton_thickness
            el.sk_l_arm.Visible = true
        end
    elseif el.sk_l_arm then el.sk_l_arm.Visible = false end
    
    if parts.rarm and hrpPos then
        local p = w2v(parts.rarm.Position)
        if p and el.sk_r_arm then
            el.sk_r_arm.From = hrpPos; el.sk_r_arm.To = p
            el.sk_r_arm.Color = color; el.sk_r_arm.Thickness = Config.skeleton_thickness
            el.sk_r_arm.Visible = true
        end
    elseif el.sk_r_arm then el.sk_r_arm.Visible = false end
    
    -- Pernas
    if parts.lleg and hrpPos then
        local p = w2v(parts.lleg.Position)
        if p and el.sk_l_leg then
            el.sk_l_leg.From = hrpPos; el.sk_l_leg.To = p
            el.sk_l_leg.Color = color; el.sk_l_leg.Thickness = Config.skeleton_thickness
            el.sk_l_leg.Visible = true
        end
    elseif el.sk_l_leg then el.sk_l_leg.Visible = false end
    
    if parts.rleg and hrpPos then
        local p = w2v(parts.rleg.Position)
        if p and el.sk_r_leg then
            el.sk_r_leg.From = hrpPos; el.sk_r_leg.To = p
            el.sk_r_leg.Color = color; el.sk_r_leg.Thickness = Config.skeleton_thickness
            el.sk_r_leg.Visible = true
        end
    elseif el.sk_r_leg then el.sk_r_leg.Visible = false end
    
    -- Linha cabeça-topo
    if el.sk_head_top then el.sk_head_top.Visible = false end
    if el.sk_hip then el.sk_hip.Visible = false end
end

-- Renderiza ESP para um player
function ESPRenderer:renderPlayer(player)
    local el = self:getElements(player)
    
    if player == LocalPlayer then
        self:hideAll(el); return
    end
    
    if not self:isEnemy(player) then
        self:hideAll(el); return
    end
    
    local character = player.Character
    if not character then
        self:hideAll(el); return
    end
    
    local data = self:getData(character)
    if not data or data.distance > Config.max_distance then
        self:hideAll(el); return
    end
    
    local color = self:isEnemy(player) and Config.color_enemy or Config.color_team
    
    -- BOX
    if Config.esp_box then
        if el.box_fill and Config.box_filled then
            el.box_fill.Size = Vector2.new(data.width, data.height)
            el.box_fill.Position = Vector2.new(data.x, data.y)
            el.box_fill.Color = Config.color_box_fill
            el.box_fill.Transparency = Config.box_fill_transparency
            el.box_fill.Visible = true
        elseif el.box_fill then
            el.box_fill.Visible = false
        end
        
        if el.box_outline then
            el.box_outline.Size = Vector2.new(data.width, data.height)
            el.box_outline.Position = Vector2.new(data.x, data.y)
            el.box_outline.Color = color
            el.box_outline.Thickness = Config.box_thickness
            el.box_outline.Visible = true
        end
    else
        if el.box_outline then el.box_outline.Visible = false end
        if el.box_fill then el.box_fill.Visible = false end
    end
    
    -- NOME
    if Config.esp_name and el.name then
        el.name.Text = data.name
        el.name.Position = Vector2.new(data.cx, data.topY - 16)
        el.name.Size = Config.name_size
        el.name.Color = Config.color_name
        el.name.Visible = true
    elseif el.name then
        el.name.Visible = false
    end
    
    -- DISTÂNCIA
    if Config.esp_distance and el.distance then
        el.distance.Text = "[" .. Helpers.formatDist(data.distance) .. "]"
        el.distance.Position = Vector2.new(data.cx, data.bottomY + 6)
        el.distance.Color = Config.color_distance
        el.distance.Visible = true
    elseif el.distance then
        el.distance.Visible = false
    end
    
    -- BARRA DE VIDA
    if Config.esp_health and el.health_bar_bg then
        local barWidth = 3
        local barX = data.x - 8
        local hpRatio = Helpers.clamp(data.humanoid.Health / math.max(data.humanoid.MaxHealth, 1), 0, 1)
        
        el.health_bar_bg.Size = Vector2.new(barWidth, data.height)
        el.health_bar_bg.Position = Vector2.new(barX, data.y)
        el.health_bar_bg.Color = Color3.fromRGB(30, 30, 40)
        el.health_bar_bg.Transparency = 0.3
        el.health_bar_bg.Visible = true
        
        local fgHeight = data.height * hpRatio
        el.health_bar_fg.Size = Vector2.new(barWidth, fgHeight)
        el.health_bar_fg.Position = Vector2.new(barX, data.y + (data.height - fgHeight))
        el.health_bar_fg.Color = Helpers.lerpColor(
            Color3.fromRGB(255, 60, 60),
            Config.color_health,
            hpRatio
        )
        el.health_bar_fg.Visible = true
        
        if el.health_text then
            el.health_text.Text = string.format("%d", math.floor(data.humanoid.Health))
            el.health_text.Position = Vector2.new(barX - 12, data.y + data.height * 0.5 - 6)
            el.health_text.Color = Config.color_health
            el.health_text.Visible = true
        end
    else
        if el.health_bar_bg then el.health_bar_bg.Visible = false end
        if el.health_bar_fg then el.health_bar_fg.Visible = false end
        if el.health_text then el.health_text.Visible = false end
    end
    
    -- TRACER
    if Config.esp_tracer and el.tracer then
        local origin
        if Config.tracer_origin == "Bottom" then
            origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        elseif Config.tracer_origin == "Center" then
            origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        else
            local mp = UserInputService:GetMouseLocation()
            origin = Vector2.new(mp.X, mp.Y)
        end
        
        el.tracer.From = origin
        el.tracer.To = Vector2.new(data.cx, data.bottomY)
        el.tracer.Color = Config.color_tracer
        el.tracer.Thickness = 1
        el.tracer.Visible = true
    elseif el.tracer then
        el.tracer.Visible = false
    end
    
    -- ESQUELETO
    if Config.esp_skeleton then
        self:drawSkeleton(el, character, Config.color_skeleton)
    else
        for _, k in ipairs({"sk_head_top","sk_neck","sk_hip","sk_l_arm","sk_r_arm","sk_l_leg","sk_r_leg"}) do
            if el[k] then el[k].Visible = false end
        end
    end
    
    -- SETA
    if Config.esp_arrow and el.arrow then el.arrow.Visible = false end -- não implementado
end

function ESPRenderer:update()
    if not Config.enabled or not hasDrawing then return end
    for _, player in ipairs(Players:GetPlayers()) do
        pcall(function() self:renderPlayer(player) end)
    end
end

