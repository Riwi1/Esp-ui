--[[
    ESP Security Test Script
    Uso: Apenas em servidores próprios para testes de segurança
    Objetivo: Verificar se o jogo protege contra leitura de memória
--]]

-- Configurações
local CONFIG = {
    enabled = true,
    team_check = true,        -- Só mostra inimigos
    box_color = Color3.fromRGB(255, 0, 0),
    name_color = Color3.fromRGB(255, 255, 255),
    health_color = Color3.fromRGB(0, 255, 0),
    max_distance = 500,
    show_health = true,
    show_name = true,
    show_distance = true,
}

-- Serviços (Roblox como exemplo de ambiente de teste)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local Drawings = {}  -- Cache de desenhos

-- Verifica se é um ambiente seguro para teste
local function isTestEnvironment()
    -- Adicione aqui verificações do SEU servidor de teste
    -- Ex: return game.PlaceId == SEU_PLACE_ID_DE_TESTE
    return true
end

-- Cria elementos de desenho (usa Drawing API se disponível)
local function createDrawing(class, properties)
    if not Drawing then return nil end
    local ok, drawing = pcall(function()
        local d = Drawing.new(class)
        for k, v in pairs(properties or {}) do
            d[k] = v
        end
        return d
    end)
    return ok and drawing or nil
end

-- Obtém bounding box de um personagem
local function getBoundingBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not (hrp and head and humanoid) then return nil end
    if humanoid.Health <= 0 then return nil end
    
    local rootPos = hrp.Position
    local headPos = head.Position
    
    -- Pega tamanho aproximado
    local size = Vector3.new(2, 5, 1)  -- Ajuste conforme seu jogo
    
    -- Converte para 2D
    local topWorld = headPos + Vector3.new(0, 0.5, 0)
    local bottomWorld = rootPos - Vector3.new(0, size.Y / 2, 0)
    
    local topScreen, topOnScreen = Camera:WorldToViewportPoint(topWorld)
    local bottomScreen, bottomOnScreen = Camera:WorldToViewportPoint(bottomWorld)
    
    if not (topOnScreen and bottomOnScreen) then return nil end
    
    local height = math.abs(bottomScreen.Y - topScreen.Y)
    local width = height * 0.5
    local x = topScreen.X - width / 2
    local y = topScreen.Y
    
    return {
        x = x, y = y,
        width = width, height = height,
        center = Vector2.new(x + width/2, y + height/2),
        distance = (Camera.CFrame.Position - rootPos).Magnitude,
        humanoid = humanoid,
        name = character.Name
    }
end

-- Verifica se é inimigo
local function isEnemy(player)
    if not CONFIG.team_check then return true end
    if not LocalPlayer.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

-- Desenha ESP para um player
local function drawESP(player, data)
    if not Drawings[player] then
        Drawings[player] = {
            box = createDrawing("Square", {
                Thickness = 1,
                Filled = false,
                Color = CONFIG.box_color,
                Visible = false
            }),
            name = createDrawing("Text", {
                Size = 14,
                Center = true,
                Outline = true,
                Color = CONFIG.name_color,
                Visible = false
            }),
            health = createDrawing("Text", {
                Size = 12,
                Center = true,
                Outline = true,
                Color = CONFIG.health_color,
                Visible = false
            }),
            distance = createDrawing("Text", {
                Size = 12,
                Center = true,
                Outline = true,
                Color = Color3.fromRGB(200, 200, 200),
                Visible = false
            })
        }
    end
    
    local d = Drawings[player]
    if not d.box then return end
    
    if not data then
        for _, item in pairs(d) do
            if item then item.Visible = false end
        end
        return
    end
    
    -- Box
    d.box.Size = Vector2.new(data.width, data.height)
    d.box.Position = Vector2.new(data.x, data.y)
    d.box.Visible = true
    
    -- Nome
    if CONFIG.show_name then
        d.name.Text = data.name
        d.name.Position = Vector2.new(data.center.X, data.y - 16)
        d.name.Visible = true
    end
    
    -- Vida
    if CONFIG.show_health then
        d.health.Text = string.format("%d HP", math.floor(data.humanoid.Health))
        d.health.Position = Vector2.new(data.center.X, data.y + data.height + 4)
        d.health.Visible = true
    end
    
    -- Distância
    if CONFIG.show_distance then
        d.distance.Text = string.format("[%dm]", math.floor(data.distance))
        d.distance.Position = Vector2.new(data.center.X, data.y + data.height + 18)
        d.distance.Visible = true
    end
end

-- Loop principal
local function onRender()
    if not CONFIG.enabled then return end
    if not isTestEnvironment() then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then
            drawESP(player, nil)
            continue
        end
        
        local character = player.Character
        if not character then
            drawESP(player, nil)
            continue
        end
        
        local data = getBoundingBox(character)
        if data and data.distance <= CONFIG.max_distance then
            drawESP(player, data)
        else
            drawESP(player, nil)
        end
    end
end

-- Cleanup
local function cleanup()
    for _, d in pairs(Drawings) do
        for _, item in pairs(d) do
            if item and item.Remove then item:Remove() end
        end
    end
    Drawings = {}
end

-- Conectar
RunService.RenderStepped:Connect(onRender)

-- Desconectar ao sair
Players.PlayerRemoving:Connect(function(player)
    if Drawings[player] then
        for _, item in pairs(Drawings[player]) do
            if item and item.Remove then item:Remove() end
        end
        Drawings[player] = nil
    end
end)

print("[ESP-Test] Script carregado. Use apenas em ambiente de teste.")
