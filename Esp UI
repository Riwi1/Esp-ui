function UI:toggleMaster()
    Config.enabled = not Config.enabled
    if Config.enabled then
        self.masterBtn.Text = "● ESP ATIVO"
        self.masterBtn.TextColor3 = Theme.success
        self.masterBtn.BackgroundColor3 = Color3.fromRGB(30, 55, 40)
        self.masterStroke.Color = Theme.success
        self.statusDot.BackgroundColor3 = Theme.success
        self:setStatus("ESP ATIVO", "success")
        self:notify("ESP LIGADO")
    else
        self.masterBtn.Text = "● ESP DESLIGADO"
        self.masterBtn.TextColor3 = Theme.text_secondary
        self.masterBtn.BackgroundColor3 = Theme.bg_tertiary
        self.masterStroke.Color = Theme.danger
        self.statusDot.BackgroundColor3 = Theme.accent
        self:setStatus("ESP desativado", "muted")
        self:notify("ESP DESLIGADO")
    end
end

