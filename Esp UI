function UI:setupDrag()
    local dragging, dragStart, startPos
    local header = self.main:FindFirstChild("Header")
    if not header then return end
    
    table.insert(self.connections, header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.main.Position
        end
    end))
    
    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
    
    table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function UI:setupHotkey()
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
            self.screen.Enabled = not self.screen.Enabled
            if self.screen.Enabled then
                self:notify("Menu aberto")
            end
        end
    end))
end

function UI:toggleCollapse()
    self.collapsed = not self.collapsed
    local targetSize = self.collapsed and UDim2.new(0, 500, 0, 52) or UDim2.new(0, 500, 0, 440)
    tween(self.main, 0.25, { Size = targetSize })
end

