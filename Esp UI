function UI:notify(msg)
    local n = create("TextLabel", {
        Size = UDim2.new(0, 320, 0, 42),
        Position = UDim2.new(0.5, -160, 0, 30),
        BackgroundColor3 = Theme.bg_secondary,
        BorderSizePixel = 0,
        Text = msg,
        TextColor3 = Theme.text_primary,
        TextSize = 13,
        Font = FONTS.heading,
        Parent = self.screen,
    })
    corner(n, 8)
    stroke(n, Theme.accent, 1, 0.3)
    task.delay(1.8, function()
        if n and n.Parent then
            tween(n, 0.3, { BackgroundTransparency = 1, TextTransparency = 1 })
            task.wait(0.3)
            n:Destroy()
        end
    end)
end

function UI:setupDrag()
    local dragging, dragStart, startPos
    local header = self.main:FindFirstChild("Header")
    if not header then return end
    table.insert(self.connections, header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.main.Position
        end
    end))
    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
    table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function UI:setupHotkeys()
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        local k = input.KeyCode
        
        if k == Hotkeys.toggleMenu then
            self.screen.Enabled = not self.screen.Enabled
            self:notify(self.screen.Enabled and "Menu aberto" or "Menu fechado")
        elseif k == Hotkeys.toggleMaster then
            self:toggleMaster()
        elseif k == Hotkeys.toggleBox then
            Config.esp_box = not Config.esp_box
            self:notify("Box: " .. (Config.esp_box and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        elseif k == Hotkeys.toggleName then
            Config.esp_name = not Config.esp_name
            self:notify("Nome: " .. (Config.esp_name and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        elseif k == Hotkeys.toggleHealth then
            Config.esp_health = not Config.esp_health
            self:notify("Vida: " .. (Config.esp_health and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        elseif k == Hotkeys.toggleDist then
            Config.esp_distance = not Config.esp_distance
            self:notify("Distância: " .. (Config.esp_distance and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        elseif k == Hotkeys.toggleTracer then
            Config.esp_tracer = not Config.esp_tracer
            self:notify("Tracer: " .. (Config.esp_tracer and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        elseif k == Hotkeys.toggleTeam then
            Config.team_check = not Config.team_check
            self:notify("Team Check: " .. (Config.team_check and "ON" or "OFF"))
            if self.activeTab == "Toggles" then self:renderContent("Toggles") end
        end
    end))
end

