local accumulator = 0
RunService.RenderStepped:Connect(function(dt)
    if not Config.enabled then return end
    
    accumulator = accumulator + dt
    local interval = 1 / math.max(Config.refresh_rate, 1)
    if accumulator >= interval then
        accumulator = 0
        esp:update()
    end
end)

