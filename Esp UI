function UI:setStatus(text, t)
    local color = Theme.text_muted
    if t == "success" then color = Theme.success
    elseif t == "danger" then color = Theme.danger
    elseif t == "warning" then color = Theme.warning
    elseif t == "accent" then color = Theme.accent end
