--=====================================================================
-- HELPERS
--=====================================================================
local function create(cls, props)
    local inst = Instance.new(cls)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end

local function tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function containsAny(str, list)
    if not str then return false end
    local lower = str:lower()
    for _, kw in ipairs(list) do
        if lower:find(kw:lower(), 1, true) then
            return true
        end
    end
    return false
end

--=====================================================================
-- DETECÇÃO DA FERA / CORES / RÓTULOS
--=====================================================================
local function isBeast(plr)
    if plr:GetAttribute(CONFIG.ESP.BeastAttribute) == true then return true end

    local char = plr.Character
    if char then
        if char:GetAttribute(CONFIG.ESP.BeastAttribute) == true then return true end
        if containsAny(char.Name, CONFIG.ESP.BeastNameMatch) then return true end
        for _, tag in ipairs(CollectionService:GetTags(char)) do
            if containsAny(tag, CONFIG.ESP.BeastNameMatch) then return true end
        end
    end
    for _, tag in ipairs(CollectionService:GetTags(plr)) do
        if containsAny(tag, CONFIG.ESP.BeastNameMatch) then return true end
    end
    if containsAny(plr.Name, CONFIG.ESP.BeastNameMatch) then return true end
    if plr.Team and containsAny(plr.Team.Name, CONFIG.ESP.BeastTeamMatch) then
        return true
    end
    return false
end

local function getESPColor(plr)
    if isBeast(plr) then return ESP_COLORS.Beast end
    return ESP_COLORS.Ally
end

local function getRoleLabel(plr)
    if isBeast(plr) then return T("beast") end
    return T("survivor")
end

--=====================================================================
-- MAPA ATIVO
--=====================================================================
local function getActiveMapRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    local current = char
    local lastModel = nil
    while current and current.Parent and current.Parent ~= Workspace do
        if current:IsA("Model") then lastModel = current end
        current = current.Parent
    end
    if current and current:IsA("Model") then return current end
    return lastModel
end

local function isInExcludedContainer(inst)
    local cur = inst
    local depth = 0
    while cur and cur ~= Workspace and depth < 8 do
        if containsAny(cur.Name, CONFIG.ESP.MapExcludeKeywords) then
            return true
        end
        cur = cur.Parent
        depth = depth + 1
    end
    return false
end

--=====================================================================
-- DETECÇÃO DE COMPUTADOR
--=====================================================================
local function isComputer(inst)
    if not inst or not inst.Parent then return false end
    if inst:IsA("Player") then return false end
    if inst:IsA("Model") and #inst:GetChildren() > 40 then return false end

    local tags = CollectionService:GetTags(inst)
    for _, tag in ipairs(tags) do
        if containsAny(tag, CONFIG.ESP.ComputerTagBlacklist) then return false end
    end
    for _, tag in ipairs(tags) do
        if containsAny(tag, CONFIG.ESP.ComputerTagMatch) then return true end
    end

    if containsAny(inst.Name, CONFIG.ESP.ComputerBlacklist) then return false end
    if containsAny(inst.Name, CONFIG.ESP.ComputerStrongMatch) then return true end

    if not CONFIG.ESP.ComputerStrictMode then
        if containsAny(inst.Name, CONFIG.ESP.ComputerWeakMatch) then
            if inst.Parent and containsAny(inst.Parent.Name, CONFIG.ESP.ComputerBlacklist) then
                return false
            end
            return true
        end
    end
    return false
end

--=====================================================================
-- DETECÇÃO DE JAULA
--=====================================================================
local function isCage(inst)
    if not inst or not inst.Parent then return false end
    if inst:IsA("Player") then return false end
    if inst:IsA("Model") and #inst:GetChildren() > 40 then return false end

    local tags = CollectionService:GetTags(inst)
    for _, tag in ipairs(tags) do
        if containsAny(tag, CONFIG.ESP.CageTagBlacklist) then return false end
    end
    for _, tag in ipairs(tags) do
        if containsAny(tag, CONFIG.ESP.CageTagMatch) then return true end
    end

    if containsAny(inst.Name, CONFIG.ESP.CageBlacklist) then return false end
    if containsAny(inst.Name, CONFIG.ESP.CageStrongMatch) then return true end
    if containsAny(inst.Name, CONFIG.ESP.CageWeakMatch) then return true end
    return false
end

