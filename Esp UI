-- STATUS PILL (dinâmica com idioma)
--=====================================================================
function updateStatusPill()
    local parts = {}
    if CONFIG.ESP.Enabled then table.insert(parts, T("spPlayer")) end
    if CONFIG.ESP.ShowComputers then table.insert(parts, T("spComputer")) end
    if CONFIG.ESP.ShowCages then table.insert(parts, T("spCage")) end
    if CONFIG.Speed.Enabled then table.insert(parts, T("spSpeed")) end
    local any = #parts > 0
    local label = any and table.concat(parts, " • ") or T("statusOff")

    StatusText.Text = label
    tween(StatusDot, 0.25, { BackgroundColor3 = any and PALETTE.White or PALETTE.AccentOff })
    tween(StatusText, 0.25, { TextColor3 = any and PALETTE.Text or PALETTE.TextDim })
    tween(StatusStroke, 0.25, { Transparency = any and 0.15 or 0.4 })
end

