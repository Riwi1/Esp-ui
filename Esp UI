--==============================================================
-- ESP RENDERER (usa Frames, não Drawing)
--==============================================================
local ESP = {}
ESP.__index = ESP

function ESP.new()
    local self = setmetatable({}, ESP)
    self.cache = {}
    
    -- ScreenGui dedicado para o ESP (independente do menu)
    local pg = getPlayerGui()
    if not pg then
        warn("[ESP] PlayerGui não encontrado!")
        return self
    end
    
    self.container = create("ScreenGui", {
        Name = "ESP_RenderLayer",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 5,
        Parent = pg,
    })
    
    return self
end

function ESP:getElements(player)
    if self.cache[player] then return self.cache[player] end
    
    local holder = create("Frame", {
        Name = "ESP_" .. player.Name,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 0),
        Parent = self.container,
    })
    
    local el = { holder = holder }
    
    -- Box outline (4 linhas via frames)
    el.box_top    = create("Frame", { BackgroundColor3 = Config.color_enemy, BorderSizePixel = 0, Parent = holder })
    el.box_bottom = create("Frame", { BackgroundColor3 = Config.color_enemy, BorderSizePixel = 0, Parent = holder })
    el.box_left   = create("Frame", { BackgroundColor3 = Config.color_enemy, BorderSizePixel = 0, Parent = holder })
    el.box_right  = create("Frame", { BackgroundColor3 = Config.color_enemy, BorderSizePixel = 0, Parent = holder })
    
    -- Nome
    el.name = create("TextLabel", {
        BackgroundTransparency = 1,
        TextColor3 = Config.color_name,
        TextSize = Config.name_size,
        Font = FONTS.title,
        TextStrokeTransparency = 0,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(0, 200, 0, 20),
        AnchorPoint = Vector2.new(0.5, 1),
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = holder,
    })
    
    -- Distância
    el.distance = create("TextLabel", {
        BackgroundTransparency = 1,
        TextColor3 = Config.color_distance,
        TextSize = 12,
        Font = FONTS.body,
        TextStrokeTransparency = 0,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(0, 100, 0, 16),
        AnchorPoint = Vector2.new(0.5, 0),
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = holder,
    })
    
    -- Barra de vida (bg + fill)
    el.hp_bg = create("Frame", {
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        BorderSizePixel = 0,
        BackgroundTransparency = 0.2,
        Parent = holder,
    })
    corner(el.hp_bg, 2)
    
    el.hp_fill = create("Frame", {
        BackgroundColor3 = Config.color_health,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Parent = el.hp_bg,
    })
    corner(el.hp_fill, 2)
    
    -- Tracer (frame fino rotacionado)
    el.tracer = create("Frame", {
        BackgroundColor3 = Config.color_tracer,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0),
        Parent = holder,
    })
    
    self.cache[player] = el
    return el
end

function ESP:hide(el)
    el.holder.Visible = false
end

function ESP:destroy(player)
    local el = self.cache[player]
    if el and el.holder then el.holder:Destroy() end
    self.cache[player] = nil
end

function ESP:isEnemy(player)
    if not Config.team_check then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

function ESP:getData(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not (hrp and head and humanoid) or humanoid.Health <= 0 then return nil end
    
    local topWorld    = head.Position + Vector3.new(0, 0.6, 0)
    local bottomWorld = hrp.Position - Vector3.new(0, hrp.Size.Y * 0.5 + 1.5, 0)
    
    local topScreen, topOn    = Camera:WorldToViewportPoint(topWorld)
    local bottomScreen, botOn = Camera:WorldToViewportPoint(bottomWorld)
    if not (topOn and botOn) then return nil end
    
    local height = math.abs(bottomScreen.Y - topScreen.Y)
    local width  = height * 0.55
    if height < 3 then return nil end
    
    return {
        x = topScreen.X - width / 2,
        y = topScreen.Y,
        w = width,
        h = height,
        cx = topScreen.X,
        bottomY = topScreen.Y + height,
        distance = (Camera.CFrame.Position - hrp.Position).Magnitude,
        humanoid = humanoid,
        name = character.Name,
    }
end

function ESP:renderPlayer(player)
    local el = self:getElements(player)
    
    if player == LocalPlayer or not self:isEnemy(player) then
        self:hide(el); return
    end
    
    local char = player.Character
    if not char then self:hide(el); return end
    
    local data = self:getData(char)
    if not data or data.distance > Config.max_distance then
        self:hide(el); return
    end
    
    el.holder.Visible = true
    
    local color = Config.color_enemy
    local th = Config.box_thickness
    
    -- Box outline (4 frames)
    if Config.esp_box then
        el.box_top.Visible    = true
        el.box_bottom.Visible = true
        el.box_left.Visible   = true
        el.box_right.Visible  = true
        
        el.box_top.Position    = UDim2.new(0, data.x, 0, data.y)
        el.box_top.Size        = UDim2.new(0, data.w, 0, th)
        el.box_top.BackgroundColor3 = color
        
        el.box_bottom.Position = UDim2.new(0, data.x, 0, data.bottomY - th)
        el.box_bottom.Size     = UDim2.new(0, data.w, 0, th)
        el.box_bottom.BackgroundColor3 = color
        
        el.box_left.Position   = UDim2.new(0, data.x, 0, data.y)
        el.box_left.Size       = UDim2.new(0, th, 0, data.h)
        el.box_left.BackgroundColor3 = color
        
        el.box_right.Position  = UDim2.new(0, data.x + data.w - th, 0, data.y)
        el.box_right.Size      = UDim2.new(0, th, 0, data.h)
        el.box_right.BackgroundColor3 = color
    else
        el.box_top.Visible = false
        el.box_bottom.Visible = false
        el.box_left.Visible = false
        el.box_right.Visible = false
    end
    
    -- Nome
    if Config.esp_name then
        el.name.Visible = true
        el.name.Text = data.name
        el.name.TextSize = Config.name_size
        el.name.Position = UDim2.new(0, data.cx, 0, data.y - 4)
        el.name.Size = UDim2.new(0, math.max(data.w * 2, 120), 0, 20)
    else
        el.name.Visible = false
    end
    
    -- Distância
    if Config.esp_distance then
        el.distance.Visible = true
        el.distance.Text = "[" .. formatDist(data.distance) .. "]"
        el.distance.Position = UDim2.new(0, data.cx, 0, data.bottomY + 4)
    else
        el.distance.Visible = false
    end
    
    -- Vida
    if Config.esp_health then
        el.hp_bg.Visible = true
        el.hp_bg.Position = UDim2.new(0, data.x - 8, 0, data.y)
        el.hp_bg.Size = UDim2.new(0, 3, 0, data.h)
        
        local ratio = clamp(data.humanoid.Health / math.max(data.humanoid.MaxHealth, 1), 0, 1)
        el.hp_fill.Size = UDim2.new(1, 0, ratio, 0)
        el.hp_fill.BackgroundColor3 = lerpColor(
            Color3.fromRGB(255, 60, 60),
            Config.color_health,
            ratio
        )
    else
        el.hp_bg.Visible = false
    end
    
    -- Tracer
    if Config.esp_tracer then
        local originX, originY
        if Config.tracer_origin == "Bottom" then
            originX = Camera.ViewportSize.X / 2
            originY = Camera.ViewportSize.Y
        elseif Config.tracer_origin == "Center" then
            originX = Camera.ViewportSize.X / 2
            originY = Camera.ViewportSize.Y / 2
        else
            local mp = UserInputService:GetMouseLocation()
            originX, originY = mp.X, mp.Y
        end
        
        local targetX = data.cx
        local targetY = data.bottomY
        local dx = targetX - originX
        local dy = targetY - originY
        local length = math.sqrt(dx * dx + dy * dy)
        local angle = math.deg(math.atan2(dy, dx)) + 90
        
        el.tracer.Visible = true
        el.tracer.Position = UDim2.new(0, originX, 0, originY)
        el.tracer.Size = UDim2.new(0, 1, 0, length)
        el.tracer.Rotation = angle
        el.tracer.BackgroundColor3 = Config.color_tracer
    else
        el.tracer.Visible = false
    end
end

function ESP:update()
    if not Config.enabled then
        for _, el in pairs(self.cache) do self:hide(el) end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        pcall(function() self:renderPlayer(player) end)
    end
end

function ESP:clear()
    for p, el in pairs(self.cache) do
        if el.holder then el.holder:Destroy() end
    end
    self.cache = {}
end

