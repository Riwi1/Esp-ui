local function destroyESP(plr)
    local data = tracked[plr]
    if not data then return end
    for _, obj in pairs(data) do
        if typeof(obj) == "Instance" and obj.Parent then obj:Destroy() end
    end
    tracked[plr] = nil
end

local function buildESP(plr)
    destroyESP(plr)
    local char = plr.Character
    if not char then return end

    local color = getESPColor(plr)

    local hl = Instance.new("Highlight")
    hl.Name = "MonoESP_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 1
    hl.OutlineTransparency = CONFIG.ESP.Transparency
    hl.FillColor = color
    hl.OutlineColor = color
    hl.Adornee = char
    hl.Parent = char

    local box = create("Frame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Parent = ESPOverlay,
    })
    local boxStroke = create("UIStroke", {
        Color = color, Thickness = CONFIG.ESP.Thickness,
        Transparency = CONFIG.ESP.Transparency, Parent = box,
    })

    local corners = {}
    for i = 1, 4 do
        corners[i] = create("Frame", {
            BackgroundColor3 = color,
            BackgroundTransparency = CONFIG.ESP.Transparency,
            BorderSizePixel = 0, Visible = false, Parent = ESPOverlay,
        })
    end

    local nameLbl = create("TextLabel", {
        BackgroundTransparency = 1, Text = plr.Name, TextColor3 = color,
        TextTransparency = CONFIG.ESP.Transparency, TextSize = 12,
        Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 160, 0, 14),
        AnchorPoint = Vector2.new(0.5, 1), Visible = false, Parent = ESPOverlay,
    })

    local roleLbl = create("TextLabel", {
        BackgroundTransparency = 1, Text = getRoleLabel(plr), TextColor3 = color,
        TextTransparency = math.min(1, CONFIG.ESP.Transparency + 0.15), TextSize = 10,
        Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.5,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 160, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0), Visible = false, Parent = ESPOverlay,
    })

    local distLbl = create("TextLabel", {
        BackgroundTransparency = 1, Text = "0m", TextColor3 = color,
        TextTransparency = CONFIG.ESP.Transparency, TextSize = 11,
        Font = Enum.Font.GothamMedium, TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 100, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0), Visible = false, Parent = ESPOverlay,
    })

    local hpBg = create("Frame", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 22),
        BackgroundTransparency = 0.35, BorderSizePixel = 0,
        Visible = false, Parent = ESPOverlay,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpBg })

    local hpFg = create("Frame", {
        BackgroundColor3 = color,
        BackgroundTransparency = CONFIG.ESP.Transparency,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = hpBg,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpFg })

    tracked[plr] = {
        hl = hl, box = box, boxStroke = boxStroke, corners = corners,
        name = nameLbl, role = roleLbl, dist = distLbl,
        hpBg = hpBg, hpFg = hpFg,
    }
end

