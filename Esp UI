--==============================================================
-- HELPERS
--==============================================================
local Helpers = {}

function Helpers.lerp(a, b, t) return a + (b - a) * t end
function Helpers.lerpColor(a, b, t)
    return Color3.new(
        Helpers.lerp(a.R, b.R, t),
        Helpers.lerp(a.G, b.G, t),
        Helpers.lerp(a.B, b.B, t)
    )
end
function Helpers.clamp(v, mn, mx) return math.max(mn, math.min(mx, v)) end

function Helpers.create(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = inst end
    return inst
end

function Helpers.corner(parent, radius)
    return Helpers.create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8),
        Parent = parent
    })
end

function Helpers.stroke(parent, color, thickness, transparency)
    return Helpers.create("UIStroke", {
        Color = color or Color3.fromRGB(60, 60, 75),
        Thickness = thickness or 1,
        Transparency = transparency or 0.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

function Helpers.padding(parent, t, r, b, l)
    return Helpers.create("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingRight  = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft   = UDim.new(0, l or r or t or 0),
        Parent = parent
    })
end

function Helpers.tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or 0.2,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

function Helpers.formatDist(studs)
    if studs < 100 then return string.format("%.0fm", studs)
    else return string.format("%.1fkm", studs / 100) end
end

--==============================================================
-- DRAWING API WRAPPER (com fallback)
--==============================================================
local Draw = {}
local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)

function Draw.new(class, props)
    if not hasDrawing then return nil end
    local ok, obj = pcall(function()
        local d = Drawing.new(class)
        for k, v in pairs(props or {}) do d[k] = v end
        return d
    end)
    return ok and obj or nil
end

