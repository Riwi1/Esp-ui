            data.hl.OutlineColor = ESP_COLORS.Computer
            data.hl.OutlineTransparency = CONFIG.ESP.Transparency
        end
        if data.name then data.name.TextColor3 = ESP_COLORS.Computer; data.name.TextTransparency = CONFIG.ESP.Transparency end
