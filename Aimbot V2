local fovGui = new("ScreenGui", {
    Name = "MonoProFov",
    ResetOnSpawn = false,
    IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    Parent = UIParent,
})

local ring = new("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    Size = UDim2.new(0, CFG.FOV.Radius * 2, 0, CFG.FOV.Radius * 2),
    BackgroundTransparency = 1,
    Parent = fovGui,
})

local SEG = 24
local segs = {}
for i = 1, SEG do
    local a = (i / SEG) * math.pi * 2
    local s = new("Frame", {
        Size = UDim2.new(1, 0, 0, CFG.FOV.Thickness),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, math.cos(a) * CFG.FOV.Radius, 0.5, math.sin(a) * CFG.FOV.Radius),
        Rotation = math.deg(a) + 90,
        BackgroundColor3 = CFG.FOV.Color,
        BackgroundTransparency = CFG.FOV.Transparency,
        BorderSizePixel = 0,
        Parent = ring,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = s })
    table.insert(segs, s)
end

function redrawFov()
    local r = CFG.FOV.Radius
    ring.Size = UDim2.new(0, r * 2, 0, r * 2)
    for i, s in ipairs(segs) do
        local a = (i / SEG) * math.pi * 2
        s.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
        s.Size = UDim2.new(1, 0, 0, CFG.FOV.Thickness)
        s.BackgroundColor3 = CFG.FOV.Color
        s.BackgroundTransparency = CFG.FOV.Transparency
    end
    fovGui.Enabled = CFG.FOV.Visible
end
redrawFov()

