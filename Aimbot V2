--=====================================================================
-- LOOP ESP (RenderStepped normal)
--=====================================================================
RunService.RenderStepped:Connect(function(dt)
    local myPos = Camera.CFrame.Position

    if CFG.ESP.Enabled then
        for plr, d in pairs(tracked) do
            if not isEnemy(plr) then
                destroyPlayer(plr)
                continue
            end
            local ch = plr.Character
            if not ch or not ch.Parent then destroyPlayer(plr); continue end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            local head = ch:FindFirstChild("Head")
            local hum = ch:FindFirstChildOfClass("Humanoid")
            local hide = false
            if not (hrp and head and hum) or hum.Health <= 0 then hide = true end
            if not hide and (hrp.Position - myPos).Magnitude > CFG.ESP.MaxDist then hide = true end

            if hide then
                hidePlayer(d)
                continue
            end

            if d.hl then d.hl.Enabled = CFG.ESP.ShowHighlight end

            local hp, onH = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local fp, onF = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            if not onH or not onF then
                hidePlayer(d)
                continue
            end

            local topX, topY = hp.X, hp.Y
            local botX, botY = fp.X, fp.Y
            local bH = math.abs(botY - topY)
            local bW = bH * 0.55
            local bX = (topX + botX) / 2 - bW / 2
            local bY = math.min(topY, botY)

            if CFG.ESP.ShowBox then
                d.box.Visible = true
                d.box.Position = UDim2.new(0, bX, 0, bY)
                d.box.Size = UDim2.new(0, bW, 0, bH)
                d.boxStroke.Enabled = true
            else
                d.box.Visible = false
                d.boxStroke.Enabled = false
            end

            if CFG.ESP.ShowName then
                d.name.Visible = true
                d.name.Position = UDim2.new(0, topX, 0, bY - 4)
                d.name.Text = plr.Name
            else
                d.name.Visible = false
            end

            if CFG.ESP.ShowDist then
                local dist = (hrp.Position - myPos).Magnitude
                d.dist.Visible = true
                d.dist.Position = UDim2.new(0, topX, 0, bY + bH + 2)
                d.dist.Text = string.format("%dm", math.floor(dist))
            else
                d.dist.Visible = false
            end

            if CFG.ESP.ShowHealth then
                d.hpBg.Visible = true
                local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                d.hpBg.Position = UDim2.new(0, bX - 8, 0, bY)
                d.hpBg.Size = UDim2.new(0, 3, 0, bH)
                d.hpFg.Size = UDim2.new(1, 0, ratio, 0)
                d.hpFg.Position = UDim2.new(0, 0, 1 - ratio, 0)
            else
                d.hpBg.Visible = false
            end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if isEnemy(plr) and plr.Character and not tracked[plr] then
                buildPlayer(plr)
            end
        end
    else
        for _, d in pairs(tracked) do hidePlayer(d) end
    end
end)

