local function toggle(parent, key, y, init, cb)
    local row = new("Frame", {
        Size = UDim2.new(1, -24, 0, 26),
        Position = UDim2.new(0, 12, 0, y),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    local lbl = new("TextLabel", {
        Size = UDim2.new(0.7, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = L(key),
        TextColor3 = init and C.Text or C.Dim,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    table.insert(uiRegistry, { obj = lbl, key = key })
    local track = new("Frame", {
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -36, 0.5, -9),
        BackgroundColor3 = init and C.On or C.Off,
        BorderSizePixel = 0,
        Parent = row,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
    local knob = new("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = init and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
        BackgroundColor3 = init and C.Black or C.Mute,
        BorderSizePixel = 0,
        Parent = track,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
    local state = init
    local function set(v)
        state = v
        tw(track, 0.18, { BackgroundColor3 = v and C.On or C.Off })
        tw(knob, 0.18, {
            Position = v and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
            BackgroundColor3 = v and C.Black or C.Mute,
        }, Enum.EasingStyle.Quint)
        tw(lbl, 0.15, { TextColor3 = v and C.Text or C.Dim })
        if cb then cb(v) end
    end
    local hit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row })
    hit.MouseButton1Click:Connect(function() set(not state) end)
    return { set = set, get = function() return state end }
end

local function slider(parent, key, y, init, min, max, cb)
    local wrap = new("Frame", {
        Size = UDim2.new(1, -24, 0, 38),
        Position = UDim2.new(0, 12, 0, y),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    local lbl = new("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 14),
        BackgroundTransparency = 1,
        Text = L(key),
        TextColor3 = C.Dim,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = wrap,
    })
    table.insert(uiRegistry, { obj = lbl, key = key })
    local val = new("TextLabel", {
        Size = UDim2.new(0.4, 0, 0, 14),
        Position = UDim2.new(0.6, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = string.format("%.2f", init),
        TextColor3 = C.Text,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = wrap,
    })
    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundColor3 = C.LineSoft,
        BorderSizePixel = 0,
        Parent = wrap,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
    local fill = new("Frame", {
        Size = UDim2.new((init - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.Text,
        BorderSizePixel = 0,
        Parent = bar,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
    local knob = new("Frame", {
        Size = UDim2.new(0, 10, 0, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((init - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
        Parent = bar,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 16),
        Position = UDim2.new(0, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = "",
        Parent = wrap,
    })
    local dragging = false
    local function update(rel)
        rel = math.clamp(rel, 0, 1)
        local v = min + (max - min) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        val.Text = string.format("%.2f", v)
        if cb then cb(v) end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

