function updateStatus()
    local parts = {}
    if CFG.ESP.Enabled then table.insert(parts, "ESP") end
    if CFG.AIM.Enabled then table.insert(parts, "AIM") end
    local any = #parts > 0
    statusTxt.Text = any and table.concat(parts, " • ") or L("statusOff")
    tw(statusDot, 0.2, { BackgroundColor3 = any and C.White or C.Off })
    tw(statusTxt, 0.2, { TextColor3 = any and C.Text or C.Dim })
    tw(statusStroke, 0.2, { Transparency = any and 0.15 or 0.5 })
end

