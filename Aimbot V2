local overlay = new("ScreenGui", {
    Name = "MonoProOverlay",
    ResetOnSpawn = false,
    IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    Parent = UIParent,
})

local tracked = {}

local function hidePlayer(d)
    if d.hl then d.hl.Enabled = false end
    if d.box then d.box.Visible = false end
    if d.name then d.name.Visible = false end
    if d.dist then d.dist.Visible = false end
    if d.hpBg then d.hpBg.Visible = false end
end

local function destroyPlayer(plr)
    local d = tracked[plr]
    if not d then return end
    for _, o in pairs(d) do
        if typeof(o) == "Instance" and o.Parent then o:Destroy() end
    end
    tracked[plr] = nil
end

local function buildPlayer(plr)
    destroyPlayer(plr)
    local ch = plr.Character
    if not ch then return end
    local col = ESP_COLOR

    local hl = Instance.new("Highlight")
    hl.Name = "MonoPro_HL"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 1
    hl.OutlineTransparency = CFG.ESP.Transparency
    hl.FillColor = col
    hl.OutlineColor = col
    hl.Adornee = ch
    hl.Parent = ch

    local box = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Parent = overlay })
    local bs = new("UIStroke", { Color = col, Thickness = CFG.ESP.Thickness, Transparency = CFG.ESP.Transparency, Parent = box })

    local name = new("TextLabel", {
        BackgroundTransparency = 1, Text = plr.Name, TextColor3 = col,
        TextTransparency = CFG.ESP.Transparency, TextSize = 12,
        Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 160, 0, 14),
        AnchorPoint = Vector2.new(0.5, 1), Visible = false, Parent = overlay,
    })
    local dist = new("TextLabel", {
        BackgroundTransparency = 1, Text = "0m", TextColor3 = col,
        TextTransparency = CFG.ESP.Transparency, TextSize = 11,
        Font = Enum.Font.GothamMedium, TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, 100, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0), Visible = false, Parent = overlay,
    })
    local hpBg = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 22), BackgroundTransparency = 0.35,
        BorderSizePixel = 0, Visible = false, Parent = overlay,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpBg })
    local hpFg = new("Frame", {
        BackgroundColor3 = col, BackgroundTransparency = CFG.ESP.Transparency,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = hpBg,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hpFg })

    tracked[plr] = { hl = hl, box = box, boxStroke = bs, name = name, dist = dist, hpBg = hpBg, hpFg = hpFg }
end

local function onPlayer(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.3)
        if CFG.ESP.Enabled and isEnemy(plr) then buildPlayer(plr) end
    end)
    if plr.Character and CFG.ESP.Enabled and isEnemy(plr) then buildPlayer(plr) end
end

for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(destroyPlayer)

--=====================================================================
-- AIMBOT — busca alvo + mira suave
--=====================================================================
local function findTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, CFG.FOV.Radius
    for _, plr in ipairs(Players:GetPlayers()) do
        if not isEnemy(plr) then continue end
        local ch = plr.Character
        if not ch then continue end
        local part = ch:FindFirstChild(CFG.AIM.Part)
        local hrp  = ch:FindFirstChild("HumanoidRootPart")
        local hum  = ch:FindFirstChildOfClass("Humanoid")
        if not (part and hrp and hum and hum.Health > 0) then continue end
        if (hrp.Position - Camera.CFrame.Position).Magnitude > CFG.AIM.MaxDist then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < bestDist then
            bestDist = d
            best = part
        end
    end
    return best
end

--=====================================================================
-- AIMBOT FIX — BindToRenderStep com prioridade de câmera
--=====================================================================
local AIM_BIND_NAME = "MonoProAimbot"

RunService:UnbindFromRenderStep(AIM_BIND_NAME)  -- limpa binds anteriores

RunService:BindToRenderStep(AIM_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not CFG.AIM.Enabled or not CFG.AIM.Holding then return end

    local target = findTarget()
    if not target then return end

    local camPos = Camera.CFrame.Position
    local targetPos = target.Position

    -- Evita câmera "travando" quando o alvo está quase na mesma posição
    if (targetPos - camPos).Magnitude < 0.5 then return end

    -- CFrame com up vector padrão (evita roll)
    local desired = CFrame.lookAt(camPos, targetPos, Vector3.new(0, 1, 0))

    -- Interpolação de suavidade correta
    -- Smooth = 0.05 → alpha quase 1 (rápido)
    -- Smooth = 1.0  → alpha pequeno (lento)
    local speedFactor = 1 / math.max(CFG.AIM.Smooth, 0.05)
    local alpha = math.clamp(dt * 60 * speedFactor / 15, 0, 1)

    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

